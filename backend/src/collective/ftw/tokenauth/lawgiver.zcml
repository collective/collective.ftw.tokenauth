<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:lawgiver="http://namespaces.zope.org/lawgiver"
    i18n_domain="ftw.lawgiver"
    >

  <include
      package="ftw.lawgiver"
      file="meta.zcml"
      />

  <lawgiver:ignore permissions="collective.ftw.tokenauth: Impersonate user,                      collective.ftw.tokenauth: Manage own Service Keys" />

</configure>
